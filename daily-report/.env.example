# Gmail OAuth2 (for AWS Lambda deployment)
GMAIL_CLIENT_ID=your-client-id
GMAIL_CLIENT_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name
GMAIL_REFRESH_TOKEN_ARN=arn:aws:secretsmanager:region:account:secret:name
RECIPIENT_EMAIL=your-email@example.com

# Gmail OAuth2 (for local development - test scripts)
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# Product Hunt API (AWS Lambda)
PRODUCT_HUNT_API_KEY_ARN=arn:aws:secretsmanager:region:account:secret:name
PRODUCT_HUNT_API_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name

# Product Hunt API (local development)
PRODUCT_HUNT_API_KEY=your-ph-key
PRODUCT_HUNT_API_SECRET=your-ph-secret

# Plaid (AWS Lambda)
PLAID_CLIENT_ID_ARN=arn:aws:secretsmanager:region:account:secret:/openpaw/plaid/client-id
PLAID_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:/openpaw/plaid/secret
PLAID_ACCESS_TOKEN_ARN=arn:aws:secretsmanager:region:account:secret:/openpaw/plaid/access-token

# Plaid (local development)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ACCESS_TOKEN=your-plaid-access-token
PLAID_ENVIRONMENT=sandbox

# General
TIMEZONE=America/Los_Angeles

# Nutrition Tracking
NUTRITIONIX_APP_ID=your-nutritionix-app-id
NUTRITIONIX_API_KEY=your-nutritionix-api-key
DAILY_FOOD_BUDGET=32

# PDF Receipts (for Uber Eats manual downloads)
PDF_RECEIPTS_FOLDER=/Users/your-username/Downloads/uber-receipts

# Stock Watchlist (Alpha Vantage - free key at https://www.alphavantage.co/support/#api-key)
# Optional: if unset, the watchlist section falls back to Yahoo Finance (no key needed).
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# Notion Daily Report (optional - sync digest items to a Notion subpage)
# Create an internal integration at https://www.notion.so/my-account/integrations,
# paste its token here, and share your "Daily Report" page with the integration.
# If either var below is unset, Notion sync is a no-op.
NOTION_API_KEY=your-notion-integration-token
# For AWS Lambda, store the token in Secrets Manager instead:
# NOTION_API_KEY_ARN=arn:aws:secretsmanager:region:account:secret:name
# The "Daily Report" page id (32-char hex from its URL: notion.so/<title>-<PAGE_ID>).
# Each run creates (or reuses) a "MM-DD" subpage under it, e.g. "09-17".
NOTION_DAILY_REPORT_PAGE_ID=your-notion-daily-report-page-id
